{
  "name": "@eriaflow/worker",
  "version": "1.0.0",
  "private": true,
  "author": "Mohamed Salem",
  "description": "EriaFlow API — Cloudflare Worker with Hono.js",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "type-check": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply eriaflow-db",
    "db:migrate:local": "wrangler d1 migrations apply eriaflow-db --local",
    "db:seed": "wrangler d1 execute eriaflow-db --file=./src/db/seed.sql --local"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/google": "^1.2.18",
    "@ai-sdk/openai": "^1.3.22",
    "@eriaflow/shared": "workspace:*",
    "@hono/zod-validator": "^0.4.3",
    "ai": "^4.3.16",
    "hono": "^4.7.4",
    "nanoid": "^5.1.5",
    "stripe": "^17.7.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.2.0"
  }
}
